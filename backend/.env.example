# LLM（memtensor relay，deepseek-v4-flash）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api-int.memtensor.cn/v1
LLM_MODEL=deepseek-v4-flash

LLM_FALLBACK_BASE_URL=http://localhost:4000/v1
LLM_FALLBACK_API_KEY=your_fallback_api_key_here
LLM_FALLBACK_MODEL=minmax2.5


# ── Embedding 后端配置 ──────────────────────────────────────────
# EMBEDDING_BACKEND 可选值：
#   openai      — OpenAI 兼容格式（默认，适用于 qwen3-embedding 等）
#   local       — 本地 BGE-M3 服务（http://localhost:8000/api/v1/embed）
#   hunyuan     — 腾讯云 Hunyuan / MemTensor relay
#   placeholder — 开发环境占位（仅调试，返回 SHA-256 伪向量）
#
# 当前活跃后端：openai（qwen3-embedding:4b）
EMBEDDING_BACKEND=openai

# ─ openai 后端所需变量 ─
EMBEDDING_BASE_URL=http://100.65.0.118:8000/v1
EMBEDDING_API_KEY=my-embedding-key-china2008
EMBEDDING_MODEL_NAME=qwen3-embedding:4b

# ─ local 后端所需变量（切换到 local 时需设置）─
# EMBEDDING_API_URL=http://localhost:8000

# ─ hunyuan 后端所需变量（切换到 hunyuan 时需设置）─
# HUNYUAN_API_KEY=your_key
# HUNYUAN_MODEL=hunyuan-embedding
# HUNYUAN_EMBEDDING_URL=https://api.hunyuan.cloud.tencent.com/v1/embeddings

# 向量维度（所有后端共用）
EMBEDDING_DIMENSION=2560

# 数据库
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
MONGODB_URL=mongodb://user:password@localhost:27017/dbname
REDIS_URL=redis://localhost:6379/0


# Neo4j（图数据库）
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# 向量数据库（Qdrant）
VECTOR_DB_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=qingshui
PRE_SEARCH_TOP_K=5


# API 访问密钥
API_KEY=your_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# LangChain 在线追踪（禁用）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Tinyshare（兼容 tushare SDK 调用方式的数据源）
TUSHARE_TOKEN=your_tinyshare_auth_code_here
# 旧 TuShare HTTP 代理地址（可选，部分 legacy fallback 仍读取）
TUSHARE_HTTP_URL=

# Sub-Project 1: 主密码（必填，长度>=8）
MASTER_PASSWORD=changeme-strong-password
# 可选：JWT 签名盐（不填用 dev 默认值，生产务必覆盖）
ACCOUNT_TOKEN_SECRET_SALT=random-string-here

# minishare（备选数据源，授权码从 minidoc.pages.dev 获取）
# 研报授权码
MINISHARE_RESEARCH_TOKEN=
# 互动易（董秘问答）授权码
MINISHARE_IRM_TOKEN=
