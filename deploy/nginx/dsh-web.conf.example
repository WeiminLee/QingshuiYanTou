# deploy/nginx/dsh-web.conf.example
# Place under /etc/nginx/conf.d/ after filling server_name (+ cert paths if TLS).
# dsh listens 127.0.0.1:3080 only — do not expose 3080 publicly.
#
# SECURITY / CUTOVER DEBT
# -----------------------
# Current 全切 default: HTTP :80 + basic auth. This is acceptable ONLY on
# private / VPN / intranet hosts. Do NOT put this config on a public edge
# without TLS. When certs exist, enable the TLS server{} below (and ideally
# redirect :80 → :443). Stub only — no real certs required to land cutover.

# --- HTTP (basic auth) — intranet / VPN only ---
server {
    listen 80;
    server_name _;  # REPLACE with real host / IP

    auth_basic "Qingshui dsh";
    auth_basic_user_file /etc/nginx/qingshui-dsh.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}

